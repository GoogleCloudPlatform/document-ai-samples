# The code declares NO Terraform backend on purpose, so each runner chooses where the state lives
# (Terraform automation services that manage state themselves inject their own backend).
#
# To keep the state in Cloud Storage, copy this file to the git-ignored backend_override.tf
# (Terraform merges *_override.tf files last) and pass the environment's bucket at init. The
# GitHub Actions workflows do exactly this:
#
#   cp backend_override.tf.example backend_override.tf
#   terraform init -backend-config="bucket=<project>-tfstate" -backend-config="prefix=<env>"
#
# For a throwaway run with local state, replace the block below with:  backend "local" {}
terraform {
  backend "gcs" {}
}
